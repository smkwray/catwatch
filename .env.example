OPENCATWATCH_USER_AGENT=OpenCatWatch/0.1 (contact contact@example.com)
OPENCATWATCH_TIMEOUT_SECONDS=30
OPENCATWATCH_POLITE_DELAY_SECONDS=0.5
OPENCATWATCH_SEC_MAX_RPS=5
OPENCATWATCH_DATA_DIR=data
# Optional: stores data under $PROJ_SHARED_DATA_ROOT/catwatch/data when OPENCATWATCH_DATA_DIR is unset
# PROJ_SHARED_DATA_ROOT=/path/to/shared/data
# Optional: pin registry/site/audit build math to one date for reproducible rebuilds
# OPENCATWATCH_AS_OF_DATE=2026-03-27
